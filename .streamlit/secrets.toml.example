# Copy to .streamlit/secrets.toml on the server (never commit the real file) and fill in.
# Lock it down: chmod 600 .streamlit/secrets.toml

# Microsoft sign-in (Entra ID app registration)
[auth]
# The CV Checker's own HTTPS address + /oauth2callback. Add the same URI in Entra ID:
# App registrations > your app > Authentication > Web > Redirect URIs.
redirect_uri = "https://cvchecker.example.laat.ac.uk/oauth2callback"
# Long random string, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "replace-with-a-long-random-string"
client_id = "Application (client) ID from the app's Overview page"
client_secret = "Client secret VALUE from Certificates & secrets"
server_metadata_url = "https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0/.well-known/openid-configuration"

# Optional extra check on top of Entra ID's "Assignment required": only these email domains get in.
[access]
allowed_domains = ["laat.ac.uk"]
# Optional: only these people get in (not case-sensitive). Leave out to allow the whole domain.
# allowed_emails = ["first.person@laat.ac.uk", "second.person@laat.ac.uk"]

# Claude API (used from the Claude phase onwards)
[anthropic]
api_key = "sk-ant-..."

# SharePoint site where finished CVs are saved. Uses the [auth] app (client_id, client_secret, tenant)
# with the Microsoft Graph application permission Sites.Selected, granted write access to this site only.
[sharepoint]
hostname = "londonacademytec.sharepoint.com"
site_path = "/sites/CVcheckeradmission"
# folder = "CVs"            # top folder in the library (default CVs)
# library = "Documents"     # document library name (default: the site's main library)

# Optional: where learned common phrases are saved (default ~/cvapp/data/learned_phrases.json, outside git)
# [phrases]
# path = "/home/ubuntu/cvapp/data/learned_phrases.json"

# Special actions (Fix CVs): named staff only, and they also need the access code.
# Only a SHA-256 hash of the code is stored here, never the code. See "Special actions" in the README
# for the command that makes the hash. Without allowed_emails, the [access] list is used.
# [special]
# code_sha256 = "<SHA-256 hash, 64 hex characters>"
# allowed_emails = ["<staff email>"]
